function c = c0()
%C0 - Speed of light in a vacuum
%   EM.CONST.C0() returns the speed of light in a vacuum in m/s
%   computed from eps0 and mu0
%
%   Example:
%       c0 = em.const.c0() % returns approx. 3.00e8
%
%   See also EM.CONST.EPS0, EM.CONST.MU0

    c = 1 / sqrt(em.const.mu0() * em.const.eps0())
end
